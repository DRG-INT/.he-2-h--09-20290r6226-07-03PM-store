# Kernel Panic Analysis System Environment Configuration

# ClickHouse
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Application
LOG_LEVEL=INFO

# Streamer
STREAMER_BATCH_SIZE=1000
STREAMER_FLUSH_INTERVAL_MS=5000
STREAMER_RAW_DEDUP=true
STREAMER_VNODE_HASH=true

# Anomaly Detector
ANOMALY_WINDOW_SIZE=100
ANOMALY_THRESHOLD=0.8
ANOMALY_RETRAIN_HOURS=24

# Model Trainer
MODEL_INPUT_DIM=100
MODEL_HIDDEN_DIM=64
MODEL_NUM_LAYERS=2
MODEL_DROPOUT=0.2
MODEL_WINDOW_SIZE=50
MODEL_BATCH_SIZE=64
MODEL_EPOCHS=50
MODEL_LEARNING_RATE=0.001
MODEL_HPO=false

# Alert Dispatcher
ALERT_CHANNELS=email,slack,webhook

# Email
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=kernel-monitor@example.com
EMAIL_TO=admin@example.com

# Slack
SLACK_WEBHOOK_URL=

# Webhook
WEBHOOK_URL=

# Data Exporter
EXPORT_DIR=/tmp/kernel_exports
EXPORT_DAYS=1
EXPORT_LIMIT=100000

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_DEBUG=false

# Logger
LOG_DIR=/tmp/kernel_logs
MAX_LOG_SIZE_MB=100
LOG_COMPRESSION=true
